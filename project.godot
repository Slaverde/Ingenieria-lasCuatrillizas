; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="La Resurreccion del Heredero de SAMAEL: El Papa Caliente"
config/description="Juego de terror y suspenso "
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://bw7ew5x05cm52"

[autoload]

InputSetup="*res://scripts/autoload/input_setup.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
GameState="*res://scripts/autoload/game_state.gd"
SceneManager="*res://scripts/autoload/scene_manager.gd"
HUD="*res://scenes/ui/hud.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[layer_names]

3d_physics/layer_1="mundo"
3d_physics/layer_2="interactuables"
3d_physics/layer_3="enemigos"
3d_physics/layer_4="jugador"
3d_physics/layer_5="bloqueo_jugador"

[rendering]

textures/vram_compression/import_etc2_astc=true
